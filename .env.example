# ==============================================================================
# FREE-TIER CLOUD ENVIRONMENT CONFIGURATION (PLUG & PLAY)
# ==============================================================================

# 1. PostgreSQL Database URL (Neon / Supabase / Render Free Tier)
# Example Neon Connection String: postgres://user:password@ep-cool-name-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgres://postgres:your_password@db.xxxxxx.supabase.co:5432/postgres?sslmode=require"

# 2. RabbitMQ Connection String (CloudAMQP Free 'Little Lemur' Plan)
# Example CloudAMQP URL: amqps://username:password@armadillo.rmq.cloudamqp.com/vhost
RABBITMQ_URL="amqps://guest:guest@localhost:5672"

# 3. Redis URL (Upstash Redis / Render Free Tier)
# Example Upstash URL: rediss://default:password@region.upstash.io:6379
REDIS_URL="redis://localhost:6379"

# 4. Server Configuration
PORT=4000
NODE_ENV=development
JWT_SECRET="super-secret-key-change-in-production-12345"
JWT_EXPIRES_IN="7d"
TIMEZONE="Asia/Dhaka"
