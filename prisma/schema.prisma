// ==============================================================================
// MEAL MANAGEMENT APP - PRISMA ORM SCHEMA (V2 PRODUCTION)
// ==============================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  USER
  ADMIN
  SUPERADMIN
}

enum UserType {
  PERMANENT
  GUEST
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
}

enum MealSourceType {
  MANUAL
  COPIED
  ADMIN_OVERRIDE
  SYSTEM_DEFAULT
}

enum MealConsumptionStatus {
  ON
  OFF
  BLOCKED_BY_EMERGENCY
  NOT_DECLARED
  COPIED
  PAID
  FAILED
}

enum TransactionType {
  CREDIT
  DEBIT
  ADJUSTMENT
  REFUND
  ADMIN_TOPUP
  MEAL_DEDUCTION
  MONTHLY_CHARGE
}

enum NotificationType {
  APPROVAL
  MEAL_CUT
  WALLET_TOPUP
  EMERGENCY_OFF
  LOW_BALANCE
  MONTHLY_BILL
  SYSTEM
}

enum NotificationStatus {
  UNREAD
  READ
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

model User {
  id              String          @id @default(uuid()) @db.Uuid
  phoneNumber     String          @unique @map("phone_number") @db.VarChar(15)
  passwordHash    String          @map("password_hash") @db.VarChar(255)
  fullName        String          @map("full_name") @db.VarChar(100)
  role            UserRole        @default(USER)
  userType        UserType        @default(PERMANENT) @map("user_type")
  approvalStatus  ApprovalStatus  @default(PENDING) @map("approval_status")
  approvedBy      String?         @map("approved_by") @db.Uuid
  approvedAt      DateTime?       @map("approved_at") @db.Timestamptz
  isActive        Boolean         @default(true) @map("is_active")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime?       @map("deleted_at") @db.Timestamptz

  approver        User?           @relation("UserApprover", fields: [approvedBy], references: [id])
  approvedUsers   User[]          @relation("UserApprover")
  profile         Profile?
  wallet          Wallet?
  declarations    MealDeclaration[]
  consumptions    MealConsumption[]
  transactions    WalletTransaction[]
  notifications   Notification[]
  approvalRequests ApprovalRequest[] @relation("UserApprovalRequest")
  reviewedRequests ApprovalRequest[] @relation("AdminReviewer")
  adminActions    AdminAction[]
  auditLogs       AuditLog[]
  reportSnapshots ReportSnapshot[]
  mealSettingsChanged MealSetting[]

  @@index([approvalStatus, createdAt(sort: Desc)])
  @@map("users")
}

model Profile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  roomNumber  String?  @map("room_number") @db.VarChar(50)
  department  String?  @db.VarChar(100)
  batch       String?  @db.VarChar(50)
  hostelName  String?  @map("hostel_name") @db.VarChar(100)
  avatarUrl   String?  @map("avatar_url")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Wallet {
  id             String              @id @default(uuid()) @db.Uuid
  userId         String              @unique @map("user_id") @db.Uuid
  currentBalance Decimal             @default(0.00) @map("current_balance") @db.Decimal(12, 2)
  currency       String              @default("BDT") @db.VarChar(3)
  version        Int                 @default(1)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id              String          @id @default(uuid()) @db.Uuid
  walletId        String          @map("wallet_id") @db.Uuid
  userId          String          @map("user_id") @db.Uuid
  transactionType TransactionType @map("transaction_type")
  amount          Decimal         @db.Decimal(12, 2)
  balanceBefore   Decimal         @map("balance_before") @db.Decimal(12, 2)
  balanceAfter    Decimal         @map("balance_after") @db.Decimal(12, 2)
  referenceType   String          @map("reference_type") @db.VarChar(50)
  referenceId     String          @map("reference_id") @db.Uuid
  createdBy       String?         @map("created_by") @db.Uuid
  note            String?
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz

  wallet          Wallet          @relation(fields: [walletId], references: [id], onDelete: Restrict)
  user            User            @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([walletId, createdAt(sort: Desc)])
  @@map("wallet_transactions")
}

model MealSetting {
  id              String    @id @default(uuid()) @db.Uuid
  mealDate        DateTime  @unique @map("meal_date") @db.Date
  breakfastOn     Boolean   @default(true) @map("breakfast_on")
  lunchOn         Boolean   @default(true) @map("lunch_on")
  dinnerOn        Boolean   @default(true) @map("dinner_on")
  emergencyOff    Boolean   @default(false) @map("emergency_off")
  emergencyReason String?   @map("emergency_reason")
  changedBy       String?   @map("changed_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  changer         User?     @relation(fields: [changedBy], references: [id], onDelete: SetNull)
  consumptions    MealConsumption[]

  @@map("meal_settings")
}

model MealPrice {
  id            String    @id @default(uuid()) @db.Uuid
  userType      UserType  @map("user_type")
  mealType      MealType  @map("meal_type")
  price         Decimal   @db.Decimal(12, 2)
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  createdBy     String?   @map("created_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@map("meal_prices")
}

model MonthlyCharge {
  id            String    @id @default(uuid()) @db.Uuid
  userType      UserType  @map("user_type")
  month         Int
  year          Int
  monthlyAmount Decimal   @map("monthly_amount") @db.Decimal(12, 2)
  createdBy     String?   @map("created_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([userType, month, year], name: "uq_monthly_charge")
  @@map("monthly_charges")
}

model MealDeclaration {
  id                    String         @id @default(uuid()) @db.Uuid
  userId                String         @map("user_id") @db.Uuid
  declarationDate       DateTime       @map("declaration_date") @db.Date
  breakfastSelected     Boolean        @default(false) @map("breakfast_selected")
  lunchSelected         Boolean        @default(false) @map("lunch_selected")
  dinnerSelected        Boolean        @default(false) @map("dinner_selected")
  sourceType            MealSourceType @default(MANUAL) @map("source_type")
  copiedFromDate        DateTime?      @map("copied_from_date") @db.Date
  declaredBeforeDeadline Boolean        @default(true) @map("declared_before_deadline")
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  consumptions          MealConsumption[]

  @@unique([userId, declarationDate], name: "uq_user_declaration_date")
  @@map("meal_declarations")
}

model MealConsumption {
  id                  String                @id @default(uuid()) @db.Uuid
  userId              String                @map("user_id") @db.Uuid
  mealDate            DateTime              @map("meal_date") @db.Date
  mealType            MealType              @map("meal_type")
  status              MealConsumptionStatus
  chargeAmount        Decimal               @default(0.00) @map("charge_amount") @db.Decimal(12, 2)
  deductedFromWallet  Boolean               @default(false) @map("deducted_from_wallet")
  declarationId       String?               @map("declaration_id") @db.Uuid
  mealSettingId       String?               @map("meal_setting_id") @db.Uuid
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.Timestamptz

  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  declaration         MealDeclaration?      @relation(fields: [declarationId], references: [id], onDelete: SetNull)
  mealSetting         MealSetting?          @relation(fields: [mealSettingId], references: [id], onDelete: SetNull)

  @@unique([userId, mealDate, mealType], name: "uq_user_meal_date_type")
  @@index([mealDate, mealType, status])
  @@map("meal_consumptions")
}

model ApprovalRequest {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @map("user_id") @db.Uuid
  submittedAt DateTime       @default(now()) @map("submitted_at") @db.Timestamptz
  reviewedBy  String?        @map("reviewed_by") @db.Uuid
  reviewedAt  DateTime?      @map("reviewed_at") @db.Timestamptz
  status      ApprovalStatus @default(PENDING)
  remark      String?
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  user        User           @relation("UserApprovalRequest", fields: [userId], references: [id], onDelete: Cascade)
  reviewer    User?          @relation("AdminReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@map("approval_requests")
}

model Notification {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @map("user_id") @db.Uuid
  title     String             @db.VarChar(150)
  message   String
  type      NotificationType   @default(SYSTEM)
  status    NotificationStatus @default(UNREAD)
  readAt    DateTime?          @map("read_at") @db.Timestamptz
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

model AdminAction {
  id           String   @id @default(uuid()) @db.Uuid
  adminUserId  String   @map("admin_user_id") @db.Uuid
  actionType   String   @map("action_type") @db.VarChar(100)
  targetEntity String   @map("target_entity") @db.VarChar(50)
  targetId     String   @map("target_id") @db.Uuid
  payloadJson  Json     @default("{}") @map("payload_json")
  reason       String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  admin        User     @relation(fields: [adminUserId], references: [id], onDelete: Restrict)

  @@map("admin_actions")
}

model AuditLog {
  id          String    @id @default(uuid()) @db.Uuid
  actorUserId String?   @map("actor_user_id") @db.Uuid
  actorRole   UserRole? @map("actor_role")
  entityType  String    @map("entity_type") @db.VarChar(50)
  entityId    String    @map("entity_id") @db.Uuid
  action      String    @db.VarChar(50)
  beforeJson  Json?     @map("before_json")
  afterJson   Json?     @map("after_json")
  ipAddress   String?   @map("ip_address") @db.VarChar(45)
  userAgent   String?   @map("user_agent")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  actor       User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model SystemJob {
  id           String    @id @default(uuid()) @db.Uuid
  jobName      String    @map("job_name") @db.VarChar(100)
  jobDate      DateTime  @map("job_date") @db.Date
  status       JobStatus @default(PENDING)
  startedAt    DateTime? @map("started_at") @db.Timestamptz
  finishedAt   DateTime? @map("finished_at") @db.Timestamptz
  errorMessage String?   @map("error_message")
  metadataJson Json      @default("{}") @map("metadata_json")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@unique([jobName, jobDate], name: "uq_job_name_date")
  @@map("system_jobs")
}

model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  aggregateType String       @map("aggregate_type") @db.VarChar(50)
  aggregateId   String       @map("aggregate_id") @db.Uuid
  eventType     String       @map("event_type") @db.VarChar(100)
  payloadJson   Json         @map("payload_json")
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  nextRetryAt   DateTime     @default(now()) @map("next_retry_at") @db.Timestamptz
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz
  publishedAt   DateTime?    @map("published_at") @db.Timestamptz

  @@index([status, nextRetryAt])
  @@map("outbox_events")
}

model ReportSnapshot {
  id             String                @id @default(uuid()) @db.Uuid
  snapshotDate   DateTime              @map("snapshot_date") @db.Date
  userId         String                @map("user_id") @db.Uuid
  breakfastStatus MealConsumptionStatus @map("breakfast_status")
  lunchStatus    MealConsumptionStatus @map("lunch_status")
  dinnerStatus   MealConsumptionStatus @map("dinner_status")
  totalMealCost  Decimal               @default(0.00) @map("total_meal_cost") @db.Decimal(12, 2)
  balanceAfter   Decimal               @map("balance_after") @db.Decimal(12, 2)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz

  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([snapshotDate, userId], name: "uq_report_snapshot_user_date")
  @@map("report_snapshots")
}
