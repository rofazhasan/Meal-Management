datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  SUPERADMIN
  ADMIN
  USER
  OWNER
  FINANCE_ADMIN
  MEAL_MANAGER
  HOSTEL_MANAGER
  AUDITOR
  SUPPORT_ADMIN
  READONLY_ADMIN
}

enum UserType {
  PERMANENT
  GUEST
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
}

enum MealSourceType {
  MANUAL
  COPIED
  ADMIN_OVERRIDE
  SYSTEM_DEFAULT
}

enum MealConsumptionStatus {
  ON
  OFF
  BLOCKED_BY_EMERGENCY
  NOT_DECLARED
  COPIED
  PAID
  FAILED
}

enum TransactionType {
  CREDIT
  DEBIT
  ADJUSTMENT
  REFUND
  ADMIN_TOPUP
  MEAL_DEDUCTION
  MONTHLY_CHARGE
  PENALTY
  DISCOUNT
  RECHARGE
  CASH_PAID
}

model User {
  id                        String             @id @default(uuid()) @db.Uuid
  phoneNumber               String             @unique @map("phone_number") @db.VarChar(15)
  passwordHash              String             @map("password_hash") @db.VarChar(255)
  fullName                  String             @map("full_name") @db.VarChar(100)
  email                     String?            @db.VarChar(150)
  role                      UserRole           @default(USER)
  userType                  UserType           @default(PERMANENT) @map("user_type")
  approvalStatus            ApprovalStatus     @default(PENDING) @map("approval_status")
  isActive                  Boolean            @default(true) @map("is_active")
  isDualMode                Boolean            @default(false) @map("is_dual_mode")
  activeMode                String             @default("USER") @map("active_mode") @db.VarChar(10)
  isIndefinitelyPaused      Boolean            @default(false) @map("is_indefinitely_paused")
  isPasswordResetRequested  Boolean            @default(false) @map("is_password_reset_requested")
  passwordResetRequestedAt  DateTime?          @map("password_reset_requested_at") @db.Timestamptz
  createdAt                 DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                 DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt                 DateTime?          @map("deleted_at") @db.Timestamptz

  profile                   Profile?
  wallet                    Wallet?
  declarations              MealDeclaration[]
  consumptions              MealConsumption[]
  transactions              WalletTransaction[]
  notifications             Notification[]
  approvalRequests          ApprovalRequest[]
  auditLogs                 AuditLog[]

  @@map("users")
}

model Profile {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @unique @map("user_id") @db.Uuid
  avatarUrl        String?   @map("avatar_url")
  bloodGroup       String?   @map("blood_group") @db.VarChar(10)
  emergencyContact String?   @map("emergency_contact") @db.VarChar(20)
  studentId        String?   @map("student_id") @db.VarChar(50)
  department       String?   @db.VarChar(100)
  batch            String?   @db.VarChar(50)
  hostelName       String?   @map("hostel_name") @db.VarChar(100)
  roomNumber       String?   @map("room_number") @db.VarChar(50)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Wallet {
  id             String              @id @default(uuid()) @db.Uuid
  userId         String              @unique @map("user_id") @db.Uuid
  currentBalance Decimal             @default(0.00) @map("current_balance") @db.Decimal(12, 2)
  currency       String              @default("BDT") @db.VarChar(3)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id              String          @id @default(uuid()) @db.Uuid
  walletId        String          @map("wallet_id") @db.Uuid
  userId          String          @map("user_id") @db.Uuid
  transactionType TransactionType @map("transaction_type")
  amount          Decimal         @db.Decimal(12, 2)
  balanceBefore   Decimal         @map("balance_before") @db.Decimal(12, 2)
  balanceAfter    Decimal         @map("balance_after") @db.Decimal(12, 2)
  referenceType   String?         @map("reference_type") @db.VarChar(50)
  referenceId     String?         @map("reference_id") @db.Uuid
  createdBy       String?         @map("created_by") @db.Uuid
  note            String?
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz

  wallet          Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallet_transactions")
}

model MealSetting {
  id              String    @id @default(uuid()) @db.Uuid
  mealDate        DateTime  @unique @map("meal_date") @db.Date
  breakfastOn     Boolean   @default(true) @map("breakfast_on")
  lunchOn         Boolean   @default(true) @map("lunch_on")
  dinnerOn        Boolean   @default(true) @map("dinner_on")
  emergencyOff    Boolean   @default(false) @map("emergency_off")
  emergencyReason String?   @map("emergency_reason")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@map("meal_settings")
}

model MealDeclaration {
  id                    String         @id @default(uuid()) @db.Uuid
  userId                String         @map("user_id") @db.Uuid
  declarationDate       DateTime       @map("declaration_date") @db.Date
  breakfastSelected     Boolean        @default(false) @map("breakfast_selected")
  lunchSelected         Boolean        @default(false) @map("lunch_selected")
  dinnerSelected        Boolean        @default(false) @map("dinner_selected")
  sourceType            MealSourceType @default(MANUAL) @map("source_type")
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, declarationDate], name: "uq_user_declaration_date")
  @@map("meal_declarations")
}

model MealConsumption {
  id                  String                @id @default(uuid()) @db.Uuid
  userId              String                @map("user_id") @db.Uuid
  mealDate            DateTime              @map("meal_date") @db.Date
  mealType            MealType              @map("meal_type")
  status              MealConsumptionStatus
  chargeAmount        Decimal               @default(0.00) @map("charge_amount") @db.Decimal(12, 2)
  deductedFromWallet  Boolean               @default(false) @map("deducted_from_wallet")
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.Timestamptz

  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mealDate, mealType], name: "uq_user_meal_date_type")
  @@map("meal_consumptions")
}

model ApprovalRequest {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @map("user_id") @db.Uuid
  status      ApprovalStatus @default(PENDING)
  remark      String?
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("approval_requests")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String   @db.VarChar(150)
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model AuditLog {
  id          String    @id @default(uuid()) @db.Uuid
  actorUserId String?   @map("actor_user_id") @db.Uuid
  action      String    @db.VarChar(50)
  details     String?
  ipAddress   String?   @map("ip_address") @db.VarChar(45)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  actor       User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}
